<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adtek.system.mapper.UserMapper">
  <select id="lock" resultType="com.adtek.system.domain.SysUserEntity">
    SELECT *
    FROM sys_user
    WHERE id = #{id}
    FOR UPDATE
  </select>
</mapper>
