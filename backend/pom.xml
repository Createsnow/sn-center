<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>com.adtek</groupId>
  <artifactId>adtek-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>adtek-platform-sn</name>
  <modules>
    <module>adtek-common</module>
    <module>adtek-framework</module>
    <module>adtek-system</module>
    <module>adtek-sn</module>
    <module>adtek-integration</module>
    <module>adtek-server</module>
  </modules>
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <poi.version>5.5.1</poi.version>
    <springdoc.version>3.1.1</springdoc.version>
    <archunit.version>1.4.1</archunit.version>
    <maven-enforcer.version>3.6.2</maven-enforcer.version>
    <spotless.version>3.10.3</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <sortpom.version>4.0.0</sortpom.version>
    <maven-checkstyle.version>3.6.0</maven-checkstyle.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.adtek</groupId>
        <artifactId>adtek-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adtek</groupId>
        <artifactId>adtek-framework</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adtek</groupId>
        <artifactId>adtek-system</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adtek</groupId>
        <artifactId>adtek-sn</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adtek</groupId>
        <artifactId>adtek-integration</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-jsqlparser</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <!-- 全模块统一源码与POM格式；validate只检查，显式spotless:apply才改文件。 -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <encoding>UTF-8</encoding>
          <lineEndings>UNIX</lineEndings>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>AOSP</style>
              <!-- 保留按SQL字段/子句手动拆分的常量，避免再次合成超长片段。 -->
              <reflowLongStrings>false</reflowLongStrings>
              <formatJavadoc>true</formatJavadoc>
              <reorderImports>true</reorderImports>
            </googleJavaFormat>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <version>${sortpom.version}</version>
              <nrOfIndentSpace>2</nrOfIndentSpace>
              <expandEmptyElements>false</expandEmptyElements>
              <sortProperties>false</sortProperties>
              <sortModules>false</sortModules>
              <sortExecutions>false</sortExecutions>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>format-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${maven-checkstyle.version}</version>
        <configuration>
          <includes>**/mapper/*.java</includes>
          <includeResources>false</includeResources>
          <includeTestResources>false</includeTestResources>
          <excludeGeneratedSources>true</excludeGeneratedSources>
          <consoleOutput>true</consoleOutput>
          <checkstyleRules>
            <module name="Checker">
              <property name="charset" value="UTF-8"/>
              <property name="tabWidth" value="4"/>
              <module name="LineLength">
                <property name="max" value="100"/>
                <property name="ignorePattern" value="^$"/>
              </module>
            </module>
          </checkstyleRules>
        </configuration>
        <executions>
          <execution>
            <id>mapper-line-length</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Amapstruct.defaultComponentModel=spring</arg>
            <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer.version}</version>
        <executions>
          <execution>
            <id>baseline</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.9,4)</version>
                </requireMavenVersion>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.h2database:*</exclude>
                    <exclude>org.xerial:sqlite-jdbc</exclude>
                    <exclude>javax.servlet:*</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-web</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <failIfNoTests>false</failIfNoTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <!-- 无 Docker 不静默 skip；该 profile 由真实设施验收和 CI 显式执行。 -->
  <profiles>
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <failIfNoTests>false</failIfNoTests>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>browser</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*E2E.java</include>
              </includes>
              <failIfNoTests>false</failIfNoTests>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
