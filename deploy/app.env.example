# 示例不是可直接使用的业务凭据；密码通过 compose.app.yml 的 Secret 文件提供。
ADTEK_DB_URL=jdbc:mysql://db.example.invalid:3306/adtek_product?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&sslMode=VERIFY_IDENTITY
ADTEK_DB_USER=adtek_app
ADTEK_MIGRATION_USER=adtek_migration
ADTEK_MIGRATION_ALLOWED_SCHEMA=adtek_product
ADTEK_REDIS_HOST=redis.example.invalid
ADTEK_REDIS_PORT=6379
