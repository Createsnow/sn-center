# 复制为 deploy/app.env 后按环境修改（app.env 不提交）。只放非秘密配置；密码与 SN_SECRET 在 deploy/.secrets/。
# 与 compose.infra.yml 合并部署时数据库主机名为 mysql；外部数据库改为实际地址并启用 TLS。
# useAffectedRows=true：UPDATE 返回实际改动行数（与原系统 PyMySQL 相同，业务依赖它判断并发冲突），不可去掉。
ADTEK_DB_URL=jdbc:mysql://mysql:3306/sn_center?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useAffectedRows=true&sslMode=PREFERRED
ADTEK_DB_USER=adtek_app
ADTEK_MIGRATION_USER=adtek_migration
# 生产环境：弱 SN_SECRET、默认管理员口令时拒绝启动
ENVIRONMENT=production
TZ=Asia/Shanghai
DB_POOL_SIZE=30
# ---- 以下与原系统同名，按需取消注释（默认值见运维手册）
# SN_INIT_ADMIN_EMP_NO=admin
# SN_INIT_ADMIN_PASSWORD=   # 生产环境必须设置（建议同样放 .secrets 由 configtree 读取）
# SN_RESET_ADMIN=false
# SN_PUSH_ENABLED=true
# SN_PUSH_POLL_SECONDS=5
# SN_PUSH_RETRY_INTERVALS=1,5,15
# SN_PUSH_RECEIPT_WAIT_MINUTES=1,5,10
# SN_MES_PULL_RATE_PER_MINUTE=60
# SN_BATCH_UNCONFIRMED_ALERT_MINUTES=60
# SN_SYNC_ENABLED=true
# SN_SYNC_INTERVAL_MINUTES=10
# SN_MAINTAIN_ENABLED=true
# SN_PARTITION_CRON=0 10 2 * * *
# SN_PARTITION_AHEAD_MONTHS=3
# SN_AUDIT_RETENTION_DAYS=1095
# SN_AUDIT_ARCHIVE_RETENTION_DAYS=1825
# AUDIT_EXPORT_LIMIT=200000
# SN_EXPORT_LIMIT=1000000
# SN_GEN_CONCURRENCY=2
# K3_URL=  K3_ACCT_ID=  K3_USERNAME=  （K3 配置也可在页面「金蝶配置」保存，页面配置优先）
