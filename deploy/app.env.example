# 复制为 deploy/app.env 后按环境修改（app.env 不提交）。只放非秘密配置；密码在 deploy/.secrets/。
# 与 compose.infra.yml 合并部署时主机名为 mysql / redis；外部数据库改为实际地址并启用 TLS。
ADTEK_DB_URL=jdbc:mysql://mysql:3306/adtek_template?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&sslMode=PREFERRED
ADTEK_DB_USER=adtek_app
ADTEK_MIGRATION_USER=adtek_migration
ADTEK_REDIS_HOST=redis
ADTEK_REDIS_PORT=6379
