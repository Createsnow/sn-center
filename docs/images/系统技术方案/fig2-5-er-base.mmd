  sn_prd_mo ||--o| sn_line_attach : "单据 + 序号"
  sn_prd_mo ||--o| sn_line_rule : "单据 + 序号"
  sn_rule ||--|{ sn_rule_version : "版本"
  sn_rule ||--o{ sn_pi_rule : "PI 绑定"
  sn_rule ||--o{ sn_line_rule : "物料行选定"
  sn_pi_counter ||--o{ sn_prd_mo : "PI"
  sn_pi_counter ||--o{ sn_gen_job : "PI"
