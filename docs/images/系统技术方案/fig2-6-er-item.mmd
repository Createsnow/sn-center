erDiagram
  sn_factory ||--o{ sn_item : "当前生产组织"
  sn_pi_counter ||--o{ sn_item : "流水归属 PI"
  sn_rule_version ||--o{ sn_item : "编码版本"
  sn_gen_job ||--o{ sn_item : "生成批次"
  sn_delivery_batch ||--|{ sn_delivery_item : "批次明细与逐枚回执"
  sn_delivery_batch ||--o{ sn_delivery_receipt : "回执存档"
  sn_item ||--o{ sn_delivery_item : "历次交付"
  sn_delivery_batch o|--o{ sn_item : "当前交付批次"
  sn_acquire_batch o|--o{ sn_item : "领取批次"
  sn_push_task ||--o{ sn_delivery_batch : "生产组织 + PI 顺序推送"
  sn_transfer ||--|{ sn_transfer_item : "转组织明细 ORG"
  sn_bill_transfer ||--|{ sn_transfer_item : "转单明细 BILL"
  sn_item ||--o{ sn_transfer_item : "历次转移"
  sn_item ||--o{ sn_delivery_alert : "冲突 / 过期告警"
  sn_item {
    bigint id PK
    varchar sn UK "全局唯一"
    varchar factory_code FK
    varchar pi_no
    varchar bill_no
    int bill_seq
    int rev "挂靠版本号"
    varchar seq_pi_no UK
    bigint seq_dec UK
    varchar length_text
    varchar status
    varchar delivery_batch_no FK
    varchar acquire_batch_no FK
    varchar suspend
    varchar mes_holder
  }
  sn_delivery_batch {
    bigint id PK
    varchar batch_no UK "PS- / PL- / XO-"
    varchar source "PUSH / PULL"
    varchar batch_type "NEW / SAME_ORG_TRANSFER / TRANSFER_IN / REMAP / TRANSFER_OUT"
    varchar factory_code
    varchar items_digest
    mediumblob body_gz
    varchar result
    varchar confirm_method
    varchar push_state
  }
  sn_delivery_item {
    bigint batch_id PK
    int line_no PK
    varchar sn
    int rev
    varchar push_type
    varchar receipt_result
  }
  sn_delivery_receipt {
    bigint id PK
    bigint batch_id FK
    varchar method
    varchar verdict
  }
  sn_delivery_alert {
    bigint id PK
    varchar alert_type "CONFLICT / STALE / CHECK"
    varchar status
  }
  sn_push_task {
    varchar factory_code PK
    varchar task_key PK "PI 或 #XO"
    varchar state
    datetime lease_until
  }
  sn_acquire_batch {
    varchar batch_no PK
    varchar factory_code UK
    varchar request_no UK
    varchar status "INCOMPLETE / DONE"
  }
  sn_bill_transfer {
    bigint id PK
    varchar transfer_no UK
    varchar mode "VOID / SPLIT"
  }
  sn_transfer {
    bigint id PK
    varchar transfer_no UK
    varchar status
    varchar from_factory
    varchar to_factory
  }
  sn_transfer_item {
    varchar kind PK
    bigint transfer_id PK
    bigint item_id PK
    int from_rev
    int to_rev
    varchar out_batch_no
  }
