{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "MES 批次处理流程",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    },
    "output": "f3-batch-check.html"
  },
  "lanes": [
    {
      "id": "main",
      "label": "处理"
    },
    {
      "id": "out",
      "label": "提前结束",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "recv",
    "route",
    "check",
    "dedup",
    "rev",
    "save"
  ],
  "nodes": [
    {
      "id": "recv",
      "lane": "main",
      "col": 0,
      "type": "external",
      "label": "收到批次"
    },
    {
      "id": "route",
      "lane": "main",
      "col": 1,
      "type": "backend",
      "label": "分流",
      "sublabel": "按 batchType"
    },
    {
      "id": "check",
      "lane": "main",
      "col": 2,
      "type": "security",
      "label": "整批校验",
      "sublabel": "orgCode、count、明细"
    },
    {
      "id": "dedup",
      "lane": "main",
      "col": 3,
      "type": "database",
      "label": "幂等去重",
      "sublabel": "batchNo 已处理?"
    },
    {
      "id": "rev",
      "lane": "main",
      "col": 4,
      "type": "backend",
      "label": "逐枚处理",
      "sublabel": "按 rev 新增 / 覆盖 / 跳过"
    },
    {
      "id": "save",
      "lane": "main",
      "col": 5,
      "type": "database",
      "label": "落库，回 OK"
    },
    {
      "id": "ping",
      "lane": "out",
      "col": 1,
      "type": "backend",
      "label": "测试批次",
      "sublabel": "回 OK，不存储"
    },
    {
      "id": "reject",
      "lane": "out",
      "col": 2,
      "type": "security",
      "label": "整批退回",
      "sublabel": "回 NG，不记 batchNo"
    },
    {
      "id": "replay",
      "lane": "out",
      "col": 3,
      "type": "backend",
      "label": "回 OK",
      "sublabel": "itemsDigest 相同"
    },
    {
      "id": "mismatch",
      "lane": "out",
      "col": 4,
      "type": "security",
      "label": "409 内容不符",
      "sublabel": "itemsDigest 不同"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "recv",
      "to": "route"
    },
    {
      "id": "e2",
      "from": "route",
      "to": "check",
      "label": "推送 / 拉取 / 转移批次"
    },
    {
      "id": "e3",
      "from": "check",
      "to": "dedup",
      "label": "通过"
    },
    {
      "id": "e4",
      "from": "dedup",
      "to": "rev",
      "label": "未处理"
    },
    {
      "id": "e5",
      "from": "rev",
      "to": "save"
    },
    {
      "id": "e6",
      "from": "route",
      "to": "ping",
      "label": "PING",
      "role": "branch"
    },
    {
      "id": "e7",
      "from": "check",
      "to": "reject",
      "label": "不通过",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e8",
      "from": "dedup",
      "to": "replay",
      "label": "已处理",
      "role": "branch"
    },
    {
      "id": "e9",
      "from": "dedup",
      "to": "mismatch",
      "variant": "security",
      "role": "error"
    }
  ]
}