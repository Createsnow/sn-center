      "label": "总部",
      "sublabel": "SN 系统页面"
    },
    {
      "id": "sn",
      "type": "backend",
      "label": "SN 系统"
    },
    {
      "id": "mes",
      "type": "frontend",
      "label": "MES"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 335,
      "label": "推送被退回"
    },
    {
      "from": 350,
      "to": 590,
      "label": "MES 修正后按批次号取回重处理"
    },
    {
      "from": 605,
      "to": 775,
      "label": "恢复推送"
    },
    {
      "from": 790,
      "to": 900,
      "label": "修正不了：总部作废"
    }
  ],
  "messages": [
    {
      "id": "r1",
      "from": "sn",
      "to": "mes",
      "y": 185,
      "label": "① 推送批次",
      "variant": "emphasis",
      "note": "批次内容建批时写定，之后不变"
    },
    {
      "id": "r2",
      "from": "mes",
      "to": "sn",
      "y": 245,
      "label": "200 已收到；③ 回执 NG",
      "variant": "return",
      "note": "message 写原因；不写数据、不记 batchNo"
    },
    {
      "id": "r3",
      "from": "sn",
      "to": "hq",
      "y": 305,
      "label": "批次失败，显示退回原因",
      "variant": "dashed",
      "note": "同一 PI 后续推送暂停"
    },
    {
      "id": "f1",
      "from": "mes",
      "to": "sn",
      "y": 375,
      "label": "② 拉取，带 batchNo",
      "variant": "emphasis",
      "note": "按批次号取回，不新建批次"
    },
    {
      "id": "f2",
      "from": "sn",
      "to": "mes",
      "y": 435,
      "label": "原批次，内容不变",
      "variant": "return"
    },
    {
      "id": "f3",
      "from": "mes",
      "to": "sn",
      "y": 495,
      "label": "③ 提交回执 OK",
      "variant": "emphasis",
      "note": "重新处理并落库后提交"
    },
    {
      "id": "f4",
      "from": "sn",
      "to": "mes",
      "y": 555,
      "label": "200 + 批次成功",
      "note": "batchResult = SUCCESS",
      "variant": "return"
    },
    {
      "id": "c1",
      "from": "mes",
      "to": "hq",
      "y": 630,
      "label": "书面告知已修正",
      "variant": "dashed"
    },
    {
      "id": "c2",
      "from": "hq",
      "to": "sn",
      "y": 690,
      "label": "继续推送",
      "variant": "default"
    },
    {
      "id": "c3",
      "from": "sn",
      "to": "mes",
      "y": 750,
      "label": "① 推送后续批次",
      "variant": "emphasis"
    },
    {
      "id": "v1",
      "from": "hq",
      "to": "sn",
      "y": 815,
      "label": "作废该批次",
      "variant": "security",
      "note": "须 MES 书面确认未处理"
    },
    {
      "id": "v2",
      "from": "sn",
      "to": "mes",
      "y": 875,
      "label": "① 新批次号重新送达",
      "variant": "emphasis",
      "note": "rev 不变；原批次 ②③ 返回 409 BATCH_VOIDED"
    }
  ]
}
