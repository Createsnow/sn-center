# 复制为 .env 后按需修改（.env 不提交）。后端、启动脚本（start.py）、前端开发服务器都读这一份；进程环境变量优先。
# cp .env.example .env
# 注释必须单独成行；写在等号后面会被当成参数值。

# ---------- 应用 ----------
APP_NAME=多生产组织 SN 防重管控
# local / test / production。production 时日志输出单行 JSON
ENVIRONMENT=local
# 服务器时区：只用于月分区与每日维护任务的执行时间。业务时间一律按 UTC 存储、接口按 ISO 8601（带 Z）输出，
# 页面与导出按各生产组织配置的时区显示（默认东八区）
TZ=Asia/Shanghai
# 是否开放 /docs（Swagger UI）与 /openapi.json
DOCS_ENABLED=true
# 登录令牌签名密钥。生产必须改成至少 32 位的随机串（改后所有人需重新登录）；
# ENVIRONMENT=production 时为空、为本示例值或不足 32 位会拒绝启动。可用 python -c "import secrets; print(secrets.token_hex(32))" 生成
SN_SECRET=change-me-to-a-long-random-string
# 登录令牌有效期（秒）。43200 = 12 小时
ACCESS_TOKEN_TTL_SECONDS=43200
# 内置管理员：空库首次启动时按这两项创建，登录后直接可用（不强制改密）。
# 生产必须改掉默认密码：ENVIRONMENT=production 时仍为 Admin@123 会拒绝建 / 重置管理员并拒绝启动
SN_INIT_ADMIN_EMP_NO=admin
SN_INIT_ADMIN_PASSWORD=Admin@123
# 应急：以 true 启动一次会把上面的工号重置为上面的密码（启用、改回管理员，不存在就新建）；用完立即删掉
# SN_RESET_ADMIN=true
# 本机演示数据（生产组织 / 规则 / 生产订单 / 演示账户）。连公司库务必 false
SN_DEMO_SEED=false
# 演示账户密码（SN_DEMO_SEED=true 时生效）
SN_DEMO_PASSWORD=Demo@1234

# ---------- MySQL 8 ----------
# 换库 / 换账户只改对应一行，重启后端生效。密码原样读取（可含 # = 等字符）；首尾有空格时用引号包住
DB_HOST=10.0.200.125
DB_PORT=3306
# 库名按环境：开发 sn_dev、测试 sn_test、正式 sn_prod
DB_NAME=sn_dev
DB_USER=appuser
DB_PASSWORD=
# 兼容旧写法：也可只写一行 DB_URL=jdbc:mysql://主机:端口/库名?参数（或 mysql://用户:密码@主机:端口/库名），
# 上面单独写了的项优先；JDBC 参数不读取
# DB_URL=jdbc:mysql://10.0.200.125:3306/sn_dev?useUnicode=true&characterEncoding=utf8
# 连接池大小
DB_POOL_SIZE=20
# 库里已有表但没有 flyway_schema_history 时：false 拒绝启动；true 写入基线。空库保持 false
DB_BASELINE_ON_MIGRATE=false
# 基线版本。1 = 视为 V1 已执行（本系统表已在且与 V1 一致）；0 = 仍执行 V1（库里只有其他业务的表、还没有本系统的表）
# DB_BASELINE_VERSION=0

# ---------- 业务参数 ----------
# 痕迹保存天数；0 = 永久。过期整月分区归档到 sn_audit_archive
SN_AUDIT_RETENTION_DAYS=1095
# 痕迹总保存天数（含在线与归档，按发生时间算）：超过的归档痕迹每天清理；0 = 归档永久保留
SN_AUDIT_ARCHIVE_RETENTION_DAYS=1825
# 提前建好的月分区数
SN_PARTITION_AHEAD_MONTHS=3
# 分区维护 / 归档的执行时间（Spring cron：秒 分 时 日 月 周）
SN_PARTITION_CRON=0 10 2 * * *
# 生成数量不超过该值同步完成；超过则后台任务执行、页面显示进度
SN_GEN_SYNC_THRESHOLD=5000
# 生成窗口默认单次上限（额度超过时默认填它，可解除）；单次生成硬上限
SN_GEN_DEFAULT_LIMIT=10000
SN_GEN_MAX_PER_RUN=500000
# 预演有效期（分钟）
SN_PREVIEW_TTL_MINUTES=30
# 页面领取：枚数不超过该值时领取完成后页面直接下载文件，超过则提示到领取批次里下载（号按 5000 枚一段认领，中途失败用原请求号重试）
SN_ACQUIRE_SYNC_FILE_LIMIT=50000
# 导出上限（行）
SN_EXPORT_LIMIT=1000000
AUDIT_EXPORT_LIMIT=200000

# ---------- 订单同步 ----------
# 定时比对同步：按修改时间增量拉取已审核单据并与快照比对（反审核、删除、变更都在这一步发现）
SN_SYNC_ENABLED=true
SN_SYNC_INTERVAL_MINUTES=10

# ---------- MES 推送 / 拉取 ----------
# 推送调度开关（关闭后只能由 MES 拉取或页面领取；多实例部署时也只需一个实例开启）
SN_PUSH_ENABLED=true
# 推送调度轮询间隔（秒）
SN_PUSH_POLL_SECONDS=5
# 推送未确认时的自动重试间隔（分钟，逗号分隔；个数即重试次数）。用尽后批次记为失败、推送中断，由总部续推
SN_PUSH_RETRY_INTERVALS_MINUTES=1,5,15
# 拉取的批次超过该时长仍未回执时产生交付告警
SN_BATCH_UNCONFIRMED_ALERT_MINUTES=30
# MES 接口账户：连续认证失败该次数后锁定该时长（分钟）
SN_MES_AUTH_MAX_FAILURES=10
SN_MES_AUTH_LOCK_MINUTES=15
# MES 拉取限流：每个生产组织每分钟最多拉取次数（超过返回 429 RATE_LIMITED）
SN_MES_PULL_RATE_PER_MINUTE=60

# ---------- Web ----------
SN_HOST=0.0.0.0
SN_PORT=8000
# Docker 前端映射到宿主机的端口
WEB_PORT=80
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
CORS_ALLOW_ANY_ORIGIN=false

# ---------- 前端（Vite 读本文件；只有 VITE_ 前缀会打进浏览器包）----------
VITE_API_BASE_URL=/api
VITE_HTTP_TIMEOUT=120000
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173

# ---------- 金蝶 K3 Cloud ----------
K3_SERVER_URL=http://10.0.200.42/k3cloud/
K3_ACCT_ID=
K3_APP_ID=
K3_APP_SECRET=
K3_USERNAME=ADTMES
# 2052 = 简体中文
K3_LCID=2052
K3_LOGIN_TIMEOUT=30
K3_QUERY_TIMEOUT=120
K3_VIEW_TIMEOUT=60
# 分页查询失败时的重试次数与间隔（秒）
K3_PAGE_RETRIES=3
K3_PAGE_RETRY_SECONDS=10

# 国内服务器构建较慢时可改镜像源（仅构建时生效）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
