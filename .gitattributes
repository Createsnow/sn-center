* text=auto eol=lf
*.java text eol=lf
*.md text eol=lf whitespace=-blank-at-eol
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
# Windows 批处理必须是 CRLF，否则 cmd 的标签跳转与多行块可能解析错误。
*.bat text eol=crlf
*.cmd text eol=crlf
*.mjs text eol=lf
backend/mvnw text eol=lf
# CSV 按原始字节保留；CRLF 属于文件内容的一部分。
*.csv -text whitespace=cr-at-eol
