* text=auto eol=lf
*.java text eol=lf
*.md text eol=lf whitespace=-blank-at-eol
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=lf
*.psd1 text eol=lf
# 下载验收产物按原始字节保留；CRLF属于文件内容和摘要的一部分。
*.csv -text whitespace=cr-at-eol
# 原迁移资料保留原始字节与摘要，不随 checkout 换行转换。
docs/archive/python-migration/** -text whitespace=cr-at-eol,-blank-at-eol
docs/releases/evidence/** -text whitespace=cr-at-eol
# 冻结验收证据和迁移SQL按本机已核对的原始字节入库，保证克隆后的摘要一致。
docs/testing/evidence/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
backend/adtek-server/src/main/resources/db/migration/*.sql -text whitespace=cr-at-eol
